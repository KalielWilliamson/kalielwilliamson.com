---
const links = {
	github: 'https://github.com/KalielWilliamson',
	linkedin: '#', // Replace with your public LinkedIn profile URL.
	orcid: '#', // Replace with your ORCID URL.
	zenodo: '#', // Replace with the Zenodo manuscript record URL.
	cv: '#', // Add your CV PDF under public/ and update this path.
};

const projects = [
	{
		title: 'Causal Observability',
		type: 'Research & engineering',
		description:
			'Building practical methods for measuring and improving the causal structure of learned representations.',
		link: links.zenodo,
		linkLabel: 'Read the manuscript',
	},
	{
		title: 'AlphaFlow',
		type: 'Open research infrastructure',
		description:
			'Reproducible research workflows, evaluation systems, and tools for turning ambitious ideas into inspectable evidence.',
		link: 'https://github.com/KalielWilliamson/alphaflow',
		linkLabel: 'Explore the project',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Kaliel Williamson — research engineer." />
		<title>Kaliel Williamson — Research Engineer</title>
	</head>
	<body>
		<main>
			<nav aria-label="Primary navigation">
				<a class="wordmark" href="#top">KW<span>.</span></a>
				<div class="nav-links">
					<a href="#work">Work</a>
					<a href="#about">About</a>
					<a href="#connect">Connect</a>
				</div>
			</nav>

			<section class="hero" id="top" aria-labelledby="hero-heading">
				<p class="eyebrow">Research engineer</p>
				<h1 id="hero-heading">Making difficult ideas <em>observable.</em></h1>
				<p class="lede">
					I work at the boundary of machine learning research, robust systems, and scientific
					software—building tools that make ambitious claims easier to test, understand, and use.
				</p>
				<div class="hero-actions">
					<a class="button primary" href="#work">Selected work <span aria-hidden="true">↓</span></a>
					<a class="button text" href={links.zenodo}>Latest manuscript <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="work" id="work" aria-labelledby="work-heading">
				<div class="section-heading">
					<p class="eyebrow">Selected work</p>
					<h2 id="work-heading">Research with a path to practice.</h2>
				</div>
				<div class="project-list">
					{projects.map((project, index) => (
						<article class="project">
							<div class="project-number">0{index + 1}</div>
							<div>
								<p class="project-type">{project.type}</p>
								<h3>{project.title}</h3>
								<p>{project.description}</p>
							</div>
							<a href={project.link} class="project-link">
								{project.linkLabel} <span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="about" id="about" aria-labelledby="about-heading">
				<div class="section-heading">
					<p class="eyebrow">About</p>
					<h2 id="about-heading">Research is stronger when its evidence is legible.</h2>
				</div>
				<div class="about-copy">
					<p>
						I am a research engineer interested in the systems that connect theory, experiments,
						and real-world deployment. My work combines careful empirical practice with the
						engineering required to make results reproducible.
					</p>
					<p>
						This site collects the projects, writing, and open-source work that shape that
						practice.
					</p>
				</div>
			</section>

			<section class="connect" id="connect" aria-labelledby="connect-heading">
				<p class="eyebrow">Connect</p>
				<h2 id="connect-heading">Let’s build something worth testing.</h2>
				<div class="contact-links">
					<a href={links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
					<a href={links.github}>GitHub <span aria-hidden="true">↗</span></a>
					<a href={links.orcid}>ORCID <span aria-hidden="true">↗</span></a>
					<a href={links.cv}>Curriculum vitae <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>
		<footer>
			<p>© {new Date().getFullYear()} Kaliel Williamson</p>
			<a href="#top">Back to top ↑</a>
		</footer>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:ital,wght@0,600;0,650;1,600;1,650&display=swap');

	:root { --ink: #1d2822; --muted: #627069; --canvas: #f5f3ed; --surface: #ebe9e1; --line: #d2d5ca; --accent: #d65c38; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; background: var(--canvas); color: var(--ink); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.55; }
	main, footer { width: min(1180px, calc(100% - 48px)); margin: auto; }
	nav { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line); }
	a { color: inherit; text-underline-offset: 4px; }
	.wordmark { font: 600 1.5rem 'DM Mono', monospace; text-decoration: none; letter-spacing: -.1em; } .wordmark span { color: var(--accent); }
	.nav-links { display: flex; gap: 26px; font-size: .88rem; }.nav-links a { text-decoration: none; }
	.hero { padding: clamp(90px, 15vw, 178px) 0 clamp(110px, 16vw, 190px); max-width: 940px; }
	.eyebrow, .project-type, .project-number { margin: 0 0 16px; color: var(--muted); font: 500 .72rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
	h1, h2, h3 { margin: 0; letter-spacing: -.045em; line-height: 1; } h1, h2 { font-family: 'Playfair Display', serif; font-weight: 600; }
	h1 { font-size: clamp(3.8rem, 9.4vw, 7.9rem); } h1 em { color: var(--accent); font-weight: 600; }
	.lede { max-width: 650px; margin: 38px 0 0; color: #3b4941; font-size: clamp(1.12rem, 1.7vw, 1.35rem); }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }.button { display: inline-flex; gap: 10px; align-items: center; font-size: .92rem; text-decoration: none; }.primary { padding: 12px 18px; background: var(--ink); color: var(--canvas); }.text { padding: 12px 4px; }
	section { border-top: 1px solid var(--line); padding: clamp(76px, 10vw, 124px) 0; }.section-heading { max-width: 650px; }.section-heading h2, .connect h2 { font-size: clamp(2.5rem, 5.4vw, 4.7rem); }
	.project-list { margin-top: 64px; }.project { display: grid; grid-template-columns: 70px minmax(0, 1fr) auto; gap: 25px; padding: 31px 0; border-top: 1px solid var(--line); align-items: start; }.project:last-child { border-bottom: 1px solid var(--line); }.project h3 { font-size: clamp(1.6rem, 3vw, 2.45rem); }.project p:not(.project-type) { max-width: 540px; margin: 12px 0 0; color: var(--muted); }.project-link { white-space: nowrap; font-size: .9rem; }
	.about { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(40px, 12vw, 150px); }.about-copy { max-width: 460px; color: #3b4941; font-size: 1.1rem; }.about-copy p:first-child { margin-top: 0; }
	.connect { padding-bottom: clamp(82px, 12vw, 150px); }.connect h2 { max-width: 850px; }.contact-links { display: flex; flex-wrap: wrap; gap: 8px 26px; margin-top: 38px; }.contact-links a { font-size: 1.05rem; }
	footer { display: flex; justify-content: space-between; padding: 25px 0 40px; color: var(--muted); border-top: 1px solid var(--line); font-size: .82rem; } footer p { margin: 0; }
	@media (max-width: 680px) { main, footer { width: min(100% - 32px, 1180px); } .nav-links { gap: 15px; } .project { grid-template-columns: 40px 1fr; gap: 16px; }.project-link { grid-column: 2; }.about { display: block; }.about-copy { margin-top: 42px; } footer { gap: 12px; } }
</style>
