---
const baseUrl = import.meta.env.BASE_URL;
const siteBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const siteUrl = 'https://kalielwilliamson.com/';
const socialImage = new URL(`${siteBase}social-card.svg`, siteUrl).href;

const links = {
	email: 'contactme@kalielwilliamson.com',
	github: 'https://github.com/KalielWilliamson',
	linkedin: 'https://www.linkedin.com/in/kaliel-williamson-94105188',
	zenodo: 'https://zenodo.org/records/21889140',
	doi: 'https://doi.org/10.5281/zenodo.21889140',
	paper: `${siteBase}research/causal-observability/`,
};

const researchQuestions = [
	{
		number: '01',
		title: 'Causal information acquisition',
		description: 'When should an agent retain a coarse view, acquire richer context, actively probe, transfer, or abstain?',
	},
	{
		number: '02',
		title: 'Auditable agent systems',
		description: 'How can typed events, replay, and evidence manifests connect model behavior to scientific and operational claims?',
	},
	{
		number: '03',
		title: 'Structured memory & world models',
		description: 'How should long-horizon agents construct and navigate causal, temporal, and topic-indexed representations?',
	},
];

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Kaliel Williamson',
	jobTitle: 'ML Systems Engineer and Independent Researcher',
	url: siteUrl,
	sameAs: [links.github, links.linkedin, links.zenodo],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Kaliel Williamson is an ML systems engineer and independent researcher studying causal information acquisition, replayable agent evaluation, and cost-sensitive control." />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href={`${siteBase}favicon.svg`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:ital,wght@0,600;0,650;1,600;1,650&display=swap" rel="stylesheet" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Kaliel Williamson — ML Systems Engineer & Independent Researcher" />
		<meta property="og:description" content="Research-minded engineering, grounded in practice." />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Kaliel Williamson — ML Systems Engineer & Independent Researcher" />
		<meta name="twitter:description" content="Research-minded engineering, grounded in practice." />
		<meta name="twitter:image" content={socialImage} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
		<title>Kaliel Williamson — ML Systems Engineer & Independent Researcher</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<main id="content">
			<nav aria-label="Primary navigation">
				<a class="wordmark" href="#top">KW<span>.</span></a>
				<div class="nav-links">
					<a href="#work">Research</a>
					<a href="#questions">Questions</a>
					<a href="#about">About</a>
					<a href="#connect">Connect</a>
				</div>
			</nav>

			<section class="hero" id="top" aria-labelledby="hero-heading">
				<p class="eyebrow">ML systems engineer &middot; Independent researcher</p>
				<h1 id="hero-heading">Building reliable learning systems&mdash;and the <em>evidence to improve them.</em></h1>
				<p class="lede">I design production ML infrastructure and research causal information acquisition, replayable agent evaluation, and cost-sensitive control.</p>
				<div class="hero-actions">
					<a class="button primary" href={links.paper}>Read the preprint <span aria-hidden="true">&rarr;</span></a>
					<a class="button text" href="#questions">Research questions <span aria-hidden="true">&darr;</span></a>
				</div>
			</section>

			<section class="proof-strip" aria-label="Professional profile">
				<span>10+ years in ML systems</span>
				<span>MSCS, Georgia Tech</span>
				<span>Technical leadership</span>
				<span>New York</span>
			</section>

			<section class="work" id="work" aria-labelledby="work-heading">
				<div class="section-heading">
					<p class="eyebrow">Selected research</p>
					<h2 id="work-heading">One clear question. A disciplined evidence trail.</h2>
				</div>
				<article class="project">
					<div class="project-number">01</div>
					<div>
						<p class="project-type">Preprint &middot; August 2026</p>
						<h3>Causal Observability for Active Reinforcement Learning</h3>
						<p>When should an RL agent pay for more information? Causal Observability Optimization treats coarse observation, boundary observation, probing, transfer, continuation, and abstention as cost-sensitive meta-actions. The work includes a Lean-checked finite theorem, typed replay infrastructure, and bounded POSCM and MiniGrid validation.</p>
						<p class="evidence-line">Lean-checked &middot; POSCM + MiniGrid &middot; CC BY 4.0</p>
					</div>
					<div class="project-links" aria-label="Causal Observability resources">
						<a href={links.paper}>Paper <span aria-hidden="true">&rarr;</span></a>
						<a href={links.zenodo}>Artifact <span aria-hidden="true">&nearr;</span></a>
						<a href={links.doi}>Cite <span aria-hidden="true">&nearr;</span></a>
					</div>
				</article>
			</section>

			<section class="questions" id="questions" aria-labelledby="questions-heading">
				<div class="section-heading">
					<p class="eyebrow">Current research questions</p>
					<h2 id="questions-heading">Research-minded engineering, grounded in practice.</h2>
				</div>
				<div class="focus-grid">
					{researchQuestions.map((question) => (
						<article>
							<p class="focus-number">{question.number}</p>
							<h3>{question.title}</h3>
							<p>{question.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="about" id="about" aria-labelledby="about-heading">
				<div class="section-heading">
					<p class="eyebrow">About</p>
					<h2 id="about-heading">Production systems meet experimental AI.</h2>
				</div>
				<div class="about-copy">
					<p>I am an ML systems engineer and independent researcher working between production infrastructure and experimental AI. Over the past decade, I have built enterprise software, MLOps platforms, applied machine-learning systems, and multimodal models, while leading technical work across AI and ML programs.</p>
					<p>My current research focuses on causal information acquisition, replayable agent systems, and evidence-backed evaluation. I am particularly interested in systems that connect formal claims, experimental execution, and reliable deployment.</p>
				</div>
			</section>

			<section class="connect" id="connect" aria-labelledby="connect-heading">
				<p class="eyebrow">Connect</p>
				<h2 id="connect-heading">Open to thoughtful research and engineering conversations.</h2>
				<p class="contact-intro">For research, collaboration, or professional inquiries, email me directly.</p>
				<a class="email-link" href={`mailto:${links.email}`}>{links.email}</a>
				<div class="contact-links">
					<span class="contact-links-label">Elsewhere</span>
					<a href={links.linkedin}>LinkedIn <span aria-hidden="true">&nearr;</span></a>
					<a href={links.github}>GitHub <span aria-hidden="true">&nearr;</span></a>
					<a href={links.zenodo}>Zenodo <span aria-hidden="true">&nearr;</span></a>
				</div>
			</section>
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} Kaliel Williamson</p>
			<a href="#top">Back to top &uarr;</a>
		</footer>
	</body>
</html>

<style>
	:root { --ink: #1d2822; --muted: #526159; --canvas: #f5f3ed; --surface: #ebe9e1; --line: #d2d5ca; --accent: #a9472b; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; background: var(--canvas); color: var(--ink); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.55; }
	main, footer { width: min(1180px, calc(100% - 48px)); margin: auto; }
	a { color: inherit; text-underline-offset: 4px; }
	.skip-link { position: fixed; z-index: 10; top: 12px; left: 12px; padding: 10px 14px; background: var(--ink); color: var(--canvas); transform: translateY(-160%); }.skip-link:focus { transform: translateY(0); }
	nav { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line); }
	.wordmark { font: 600 1.5rem 'DM Mono', monospace; text-decoration: none; letter-spacing: -.1em; } .wordmark span { color: var(--accent); }
	.nav-links { display: flex; gap: 26px; font-size: .88rem; }.nav-links a { text-decoration: none; }
	.hero { padding: clamp(72px, 9vw, 116px) 0 clamp(72px, 8vw, 100px); max-width: 980px; }
	.eyebrow, .project-type, .project-number, .focus-number { margin: 0 0 16px; color: var(--muted); font: 500 .78rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
	h1, h2, h3 { margin: 0; letter-spacing: -.045em; line-height: 1; } h1, h2 { font-family: 'Playfair Display', serif; font-weight: 600; }
	h1 { font-size: clamp(3.35rem, 6.4vw, 5.6rem); line-height: .96; } h1 em { color: var(--accent); font-weight: 600; }
	.lede { max-width: 690px; margin: 38px 0 0; color: #35433c; font-size: clamp(1.12rem, 1.7vw, 1.35rem); }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }.button { display: inline-flex; gap: 10px; align-items: center; font-size: .92rem; text-decoration: none; }.primary { padding: 12px 18px; background: var(--ink); color: var(--canvas); }.text { padding: 12px 4px; }
	.proof-strip { display: flex; flex-wrap: wrap; gap: 10px 28px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font: 500 .78rem 'DM Mono', monospace; letter-spacing: .03em; }
	section:not(.hero):not(.proof-strip) { border-top: 1px solid var(--line); padding: clamp(76px, 10vw, 124px) 0; }.section-heading { max-width: 760px; }.section-heading h2, .connect h2 { font-size: clamp(2.5rem, 5.4vw, 4.7rem); }
	.project { display: grid; grid-template-columns: 70px minmax(0, 1fr) auto; gap: 25px; padding: 42px 0; margin-top: 64px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); align-items: start; }.project h3 { max-width: 760px; font-size: clamp(1.8rem, 3.4vw, 3rem); }.project p:not(.project-type):not(.evidence-line) { max-width: 720px; margin: 16px 0 0; color: var(--muted); font-size: 1.04rem; }.evidence-line { margin: 20px 0 0; color: var(--ink); font: 500 .78rem 'DM Mono', monospace; }.project-links { display: grid; gap: 11px; min-width: 90px; font-size: .9rem; }
	.focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 64px; }.focus-grid article { min-height: 270px; padding: 25px; background: var(--surface); }.focus-number { margin: 0 0 58px; color: var(--accent); }.focus-grid h3 { font-size: clamp(1.45rem, 2.5vw, 2rem); }.focus-grid p:not(.focus-number) { margin: 13px 0 0; color: var(--muted); font-size: .98rem; }
	.about { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(40px, 12vw, 150px); }.about-copy { max-width: 500px; color: #35433c; font-size: 1.1rem; }.about-copy p:first-child { margin-top: 0; }
	.connect { padding-bottom: clamp(82px, 12vw, 150px); }.connect h2 { max-width: 880px; }.contact-intro { max-width: 520px; margin: 30px 0 0; color: var(--muted); font-size: 1.06rem; }.email-link { display: inline-block; margin-top: 13px; color: var(--accent); font: 500 clamp(1.15rem, 2.2vw, 1.45rem) 'DM Mono', monospace; letter-spacing: -.04em; text-underline-offset: 7px; }.contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 26px; margin-top: 38px; }.contact-links-label { color: var(--muted); font: 500 .78rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }.contact-links a { font-size: 1.05rem; }
	footer { display: flex; justify-content: space-between; padding: 25px 0 40px; color: var(--muted); border-top: 1px solid var(--line); font-size: .82rem; } footer p { margin: 0; }
	@media (max-width: 680px) { main, footer { width: min(100% - 32px, 1180px); } .nav-links { gap: 15px; } .proof-strip { gap: 8px 16px; }.project { grid-template-columns: 40px 1fr; gap: 16px; margin-top: 42px; }.project-links { grid-column: 2; display: flex; flex-wrap: wrap; gap: 16px; }.focus-grid { grid-template-columns: 1fr; gap: 10px; margin-top: 42px; }.focus-grid article { min-height: 0; }.focus-number { margin-bottom: 34px; }.about { display: block; }.about-copy { margin-top: 42px; } footer { gap: 12px; } }
	@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
